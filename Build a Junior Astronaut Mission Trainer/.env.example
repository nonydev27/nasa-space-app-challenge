# Copy to .env (never commit .env).
#
# Server-side NASA key used by the /api proxy (dev server and `npm start`).
# Get a free key instantly at https://api.nasa.gov/ — the shared DEMO_KEY allows
# only a few DONKI calls per hour and quickly returns HTTP 429.
NASA_API_KEY=nrjJK9RJRLgzcKBpQJW8MBTkMj8zmRG7Mm7cnRKD

# Optional: point a static build at a crew relay hosted elsewhere (WebSocket URL).
# VITE_CREW_URL=wss://your-host.example.com/crew

# Optional relay limits for production (defaults shown).
# CREW_MAX_ROOMS=200
# CREW_MAX_CONNECTIONS=800
# CREW_IDLE_ROOM_MIN=120
# CREW_LOG=1
# PORT=8080
